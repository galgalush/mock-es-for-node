{
  "name": "mock-es-for-node",
  "version": "1.0.0",
  "description": "A lightweight in-memory ElasticSearch mock for Node.js unit testing with TypeScript support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "ts-node src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/galgalush/mock-es-for-node"
  },
  "keywords": [
    "elasticsearch",
    "mock",
    "testing",
    "unit-test",
    "typescript",
    "nodejs",
    "in-memory",
    "search",
    "elastic"
  ],
  "author": "Gal Koren",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/galgalush/mock-es-for-node/issues"
  },
  "homepage": "https://github.com/galgalush/mock-es-for-node",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "20.17.0",
    "jest": "29.4.3",
    "ts-jest": "29.1.1",
    "ts-loader": "9.2.3",
    "ts-node": "10.9.1",
    "typescript": "5.1.6"
  },
  "packageManager": "pnpm@10.6.5"
}
